                  "    pm.expect(json.data.token).to.be.a('string').and.not.empty;",
                  "    pm.expect(json.data).to.have.property('expires_in');",
                  "    pm.expect(json.data.expires_in).to.be.above(0);",
                  "});",
                  "pm.collectionVariables.set('token', pm.response.json().data.token);"
                ]
              }
