      "item": [
        {
          "name": "Register — success (201)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jane Doe\",\n  \"email\": \"jane@example.com\",\n  \"password\": \"secret123\",\n  \"role\": \"student\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": ["{{base_url}}"],
              "path": ["auth", "register"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Response has success envelope', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.status).to.eql('success');",
                  "    pm.expect(json).to.have.property('message');",
                  "    pm.expect(json).to.have.property('data');",
                  "});",
                  "pm.test('Response does not contain plaintext password', function () {",
                  "    var body = pm.response.text();",
                  "    pm.expect(body).to.not.include('secret123');",
                  "});"
                ]
              }
            }
          ]
        },
